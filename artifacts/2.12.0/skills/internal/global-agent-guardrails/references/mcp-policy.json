  "executors": {
    "posthog": {
      "exec": {
        "parameter": "command",
        "allowCommands": "^(help|tools|search|info|schema|learn)(\\s|$)",
        "allowCalls": "^(query-[a-z0-9-]+|execute-sql|read-data-schema|docs-search|metric-list|metric-describe|data-catalog-metric-run|project-get|projects-get|organizations-get|generate-app-url|explain-chart|advanced-activity-logs-list|[a-z0-9-]+-(get|get-all|list|retrieve))$"
      }
    },
    "tiktok-ads": {
      "tool_execute": {
        "parameter": "tool_name",
        "allowCalls": "^[a-z0-9_]+_(get|list)$"
      }
    },
    "plugin_convex_convex": {
      "run": {
        "parameter": "functionName",
        "note": "a Convex function may be a mutation or action; stopped as unknown, use runOneoffQuery for reads"
      }
    },
    "github": {
      "merge_pull_request": {
        "note": "checked by the same merge pass as the gh CLI merge: needs sha (head) and a fresh pass from pr-review-status --gate"
      }
    }
  },
