{
  "schemaVersion": 1,
  "policyVersion": "1.0.0",
  "observedOn": "2026-11-08",
  "about": "MCP spend guard (DS 2.12.0). Precedence: stop list > generic executors > allow list > stop as unknown. A server in freeServers carries no money, messages to people or account-security tools and passes whole. Every other server is governed: only its exact allowed tool names pass; a new or invented tool, even one named get_*, is stopped until a new DS version lists it.",
  "freeServers": [
    "t3-code",
    "context7",
    "shadcn",
    "mobbin",
    "expect",
    "plugin_linear_linear",
    "claude_ai_Claude_Docs",
    "claude_ai_Notion",
    "plugin_exa_exa",
    "computer-use",
    "claude-in-chrome",
    "Claude_Browser",
    "remote-devices",
    "jev",
    "ide"
  ],
  "categories": {
    "incremental-spend": "Stop 1 (incremental spend): this tool can buy, start metered usage or move money.",
    "destruction": "Stop 2 (destruction): this tool deletes data that cannot be recovered.",
    "message-to-people": "Stop 3 (messages to people): this tool sends or shares to real people.",
    "account-security": "Stop 4 (account security): this tool grants access, exports a secret or changes account security.",
    "unknown": "Stopped as unknown: this MCP tool or input is not on the versioned allow list, so the guard cannot show it is free, reversible and private."
  },
