{
  "name": "@aohys/development-system",
  "version": "1.33.0",
  "contractVersion": "1.33.0",
  "private": true,
  "description": "Canonical, installable, and reversible AOHYS development contract.",
  "type": "module",
  "bin": {
    "aohys-development-system": "./bin/development-system.mjs"
  },
  "scripts": {
    "audit": "./bin/development-system audit",
    "legacy:benchmark": "node ./scripts/run-benchmarks.mjs",
    "benchmark:architecture": "node ./scripts/architecture-benchmark.mjs",
    "benchmark:codex": "node ./scripts/codex-benchmark-runtime.mjs",
    "install:local": "./bin/development-system setup",
    "measure:v2": "node ./scripts/measure-v2.mjs",
    "legacy:operator:probe": "node ./scripts/probe-lifecycle-interface.mjs",
    "t3code:probe": "node ./scripts/probe-t3code.mjs",
    "t3code:revalidate": "node ./scripts/revalidate-t3code-evidence.mjs",
    "recertify:isolated": "node ./scripts/recertify-isolated-scenario.mjs",
    "legacy:harnesses:validate": "node ./scripts/validate-harnesses.mjs",
    "rollout:validate": "node ./scripts/validate-pilot-rollout.mjs",
    "roster:check": "node ./scripts/validate-agent-roster.mjs",
    "reader:browser": "node ./scripts/verify-technical-reader-browser.mjs",
    "implement-preview": "./bin/development-system implement-preview",
    "skills:audit": "./bin/development-system audit-skills --version 0.51.0 --evidence \"$HOME/.development-system/private/reports/skills-live-latest.json\"",
    "skills:probe": "node ./scripts/probe-harness-skills.mjs",
    "skills:sync": "./bin/development-system sync-skills --version 0.51.0",
    "smoke:repositories": "node ./scripts/smoke-repository-audits.mjs",
    "scenario": "node ./scripts/reproduce-installation.mjs && node ./scripts/reproduce-skills.mjs && node ./scripts/reproduce-lifecycle.mjs && node ./scripts/reproduce-repository-preparation.mjs && node ./scripts/reproduce-governance.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "validate:global": "python3 ./scripts/validate-development-system.py --repos-root ..",
    "check:no-tests": "./bin/development-system check-no-tests",
    "validate:repository": "./bin/development-system validate-repository",
    "verify": "pnpm run roster:check && pnpm run typecheck && pnpm run validate:repository && pnpm run release:prepare",
    "release:prepare": "node ./scripts/build-release-1330.mjs --check",
    "release:pack": "node ./scripts/pack-distribution.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "packageManager": "pnpm@11.7.0",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "bin/",
    "src/",
    "config/",
    "artifacts/",
    "manifests/",
    "catalog/",
    "scripts/",
    "benchmarks/suite.json",
    "docs/architecture-reference-pack.md",
    ".development-system-package.json",
    "README.md",
    "LICENSE",
    "runtime/",
    "claude/"
  ]
}
